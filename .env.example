# VisualTaste local configuration. Copy to `.env` and edit as needed.
# Every value here has a working default; `.env` only overrides.

# --- Roots -------------------------------------------------------------------
# Repo root. Leave unset: it is derived from the package location.
# VT_PROJECT_ROOT=C:\VisualAI

# Derivatives, embeddings, database, model artefacts, caches (internal SSD).
# VT_DATA_ROOT=C:\VisualAI\data

# Originals + backups. Leave unset to run the detection ladder in config.py
# (an external drive is preferred; the repo-internal `archive/` is the fallback).
# VT_ARCHIVE_ROOT=D:\VisualTasteArchive

# --- Reproducibility ---------------------------------------------------------
VT_SEED=1729

# --- Disk guard --------------------------------------------------------------
# Long jobs stop cleanly when the archive drive drops below this many GB free.
VT_MIN_FREE_GB=25
# Originals larger than this are skipped (a handful of PD12M museum scans are
# tens of MB and would eat the disk budget for no gain at 1024 px).
VT_MAX_ORIGINAL_MB=8

# --- Acquisition -------------------------------------------------------------
VT_HTTP_CONCURRENCY=4
VT_USER_AGENT=VisualTaste/0.1 (personal research; local use)

# --- Learning ----------------------------------------------------------------
# Labels are retrained every N new events while R1-R5 is the active rung.
VT_RETRAIN_EVERY=20
# The neural ranker (R6) refuses to train below this many labels.
VT_NEURAL_MIN_LABELS=1500

# --- API ---------------------------------------------------------------------
# Never change the host. The brief forbids binding anything but loopback.
VT_API_HOST=127.0.0.1
VT_API_PORT=8000
